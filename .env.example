# ===== 环境配置模板 =====
# 复制为 .env.development 或 .env.production 后填入真实值

NODE_ENV=development
PORT=3001

# Image generation queue
IMAGE_WORKER_CONCURRENCY=10

# Provider response streaming
IMAGE_STREAM_ENABLED=true
IMAGE_PARTIAL_IMAGES=0

# 数据库（目标数据库不存在时会自动创建）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=artgen
DB_PASSWORD=your_password_here
DB_DATABASE=artgen

# JWT（留空时启动会生成强随机值并写回当前环境文件）
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 管理员（用户名和邮箱必填；密码留空时会生成强随机值并写回）
ADMIN_USERNAME=your_admin_username_here
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=artgen
MINIO_PUBLIC_URL=http://localhost:9000/artgen

# Sub2API
SUB2API_BASE_URL=http://127.0.0.1:9099
SUB2API_KEY=your_api_key_here
PROMPT_REWRITE_MODEL=gpt-5.4-mini

# AI lines (keys fall back to SUB2API_KEY when left empty)
AI_LINES_CONFIG_FILE=config/ai-lines.json
AI_DEFAULT_LINE=line-a
AI_LINE_A_BASE_URL=https://line-a.example.com
AI_LINE_A_API_KEY=
AI_LINE_B_BASE_URL=https://line-b.example.com
AI_LINE_B_API_KEY=

# Optional: only enable when browser clients call Nest directly
# ENABLE_CORS=true
# CORS_ALLOWED_ORIGINS=https://frontend.example.com

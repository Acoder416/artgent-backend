# ===== 环境配置模板 =====
# 复制为 .env.development 或 .env.production 后填入真实值

NODE_ENV=development
PORT=3001

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=artgen
DB_PASSWORD=your_password_here
DB_DATABASE=artgen

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=artgen
MINIO_PUBLIC_URL=http://localhost:9000/artgen

# Sub2API
SUB2API_BASE_URL=http://127.0.0.1:9099
SUB2API_KEY=your_api_key_here

# CORS
FRONTEND_URL=http://localhost:3002
